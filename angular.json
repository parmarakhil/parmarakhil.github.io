{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1, 
  "newProjectRoot": "projects",
  "projects": {
    "parmarakhil.github.io": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "baseHref": "/",
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/parmarakhil.github.io",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "aot": true,
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/sitemap.xml",
              "src/robots.txt"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            },
            "en": {
              "aot": true,
              "i18nFile": "src/locales/messages.en.xlf",
              "i18nFormat": "xlf",
              "i18nLocale": "en",
              "i18nMissingTranslation": "error"
            },
            "pt": {
              "aot": true,
              "i18nFile": "src/locales/messages.pt.xlf",
              "i18nFormat": "xlf",
              "i18nLocale": "pt",
              "i18nMissingTranslation": "error"
            },
            "es5": {
              "tsConfig": "./tsconfig.es5.json"
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "parmarakhil.github.io:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "parmarakhil.github.io:build:production"
            },
            "en": {
              "browserTarget": "parmarakhil.github.io:build:en"
            },
            "pt": {
              "browserTarget": "parmarakhil.github.io:build:pt"
            },
            "es5": {
              "browserTarget": "parmarakhil.github.io:build:es5"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "parmarakhil.github.io:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "tsconfig.app.json",
              "tsconfig.spec.json",
              "e2e/tsconfig.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        },
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "parmarakhil.github.io:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "parmarakhil.github.io:serve:production"
            }
          }
        }
      }
    },
    "we-are-one": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/we-are-one",
      "sourceRoot": "projects/we-are-one/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/we-are-one",
            "index": "projects/we-are-one/src/index.html",
            "browser": "projects/we-are-one/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/we-are-one/tsconfig.app.json",
            "assets": [
              "projects/we-are-one/src/favicon.ico",
              "projects/we-are-one/src/assets"
            ],
            "styles": [
              "projects/we-are-one/src/styles.css"
            ],
            "scripts": [],
            "server": "projects/we-are-one/src/main.server.ts",
            "prerender": true,
            "ssr": {
              "entry": "projects/we-are-one/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "we-are-one:build:production"
            },
            "development": {
              "buildTarget": "we-are-one:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "we-are-one:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/we-are-one/tsconfig.spec.json",
            "assets": [
              "projects/we-are-one/src/favicon.ico",
              "projects/we-are-one/src/assets"
            ],
            "styles": [
              "projects/we-are-one/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "defaultProject": "parmarakhil.github.io"
}
